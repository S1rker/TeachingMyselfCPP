{
    // Use the C++ (lldb) debugger on macOS. This configuration uses the
    // existing build task "C/C++: g++ build active file" as a preLaunchTask.
    // Start debugging with F5.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug test1.cpp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "C/C++: g++ build active file",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
